{
  "name": "kadmos",
  "version": "1.1.1",
  "author": "Christian Leicht",
  "type": "module",
  "license": "ISC",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:css": "sass src/assets/styles.scss src/assets/styles.css --no-source-map",
    "prestart": "yarn build:css",
    "prebuild": "yarn build:css",
    "prebuild:app": "yarn build:css",
    "build": "rimraf ./dist && tsc && node -e \"require('fs').mkdirSync('dist/assets',{recursive:true});require('fs').copyFileSync('src/assets/styles.css','dist/assets/styles.css')\"",
    "build:app": "rimraf ./dist && vite build",
    "start": "vite",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "yarn build && yarn npm publish"
  },
  "files": [
    "/dist",
    "/package.json",
    "/README.md",
    "/LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leicht-io/kadmos.git"
  },
  "bugs": {
    "url": "https://github.com/leicht-io/kadmos/issues"
  },
  "homepage": "https://github.com/leicht-io/kadmos#readme",
  "engines": {
    "node": ">=22.12.0",
    "yarn": "1.22"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "description": ""
}
