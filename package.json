{
  "name": "kadmos",
  "version": "2.0.0",
  "description": "Zero-configuration 3D model viewer for STL and 3MF files, built on three.js: auto-fit framing, realistic lighting, dimensions, section views, measuring and build-plate fit checks.",
  "keywords": [
    "stl",
    "3mf",
    "3d",
    "3d-printing",
    "viewer",
    "model-viewer",
    "three",
    "threejs",
    "webgl"
  ],
  "author": "Christian Leicht",
  "type": "module",
  "license": "ISC",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:css": "sass src/assets/styles.scss src/assets/styles.css --no-source-map",
    "build": "yarn build:css && rimraf ./dist && tsc && node scripts/postbuild.mjs",
    "build:app": "vite build",
    "start": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "yarn build && yarn npm publish"
  },
  "files": [
    "/dist",
    "/package.json",
    "/README.md",
    "/LICENSE",
    "/CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leicht-io/kadmos.git"
  },
  "bugs": {
    "url": "https://github.com/leicht-io/kadmos/issues"
  },
  "homepage": "https://github.com/leicht-io/kadmos#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@4.12.0",
  "peerDependencies": {
    "three": ">=0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
